// -*- mode: jsonc -*-
  // ========================================================
  //   CONFIGURACIÓN DE WAYBAR
  //   Hecho por: Morta
  // ========================================================

{
    "layer": "top",
    "position": "top",
    "height": 5, 
    "spacing": 2, 

    /* --- Orden de módulos--- */
    "modules-left": [
        "custom/arch",
        "clock"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "tray",
        "memory",
        "cpu",
        "pulseaudio",
        "bluetooth",
        "network",
        "custom/power"
    ],

    /* --- Módulos --- */
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "all-outputs": true,
        "active-only": false,
        "format-icons": {
            "default": "",
            "active": "",
            "urgent": ""
        },
        "persistent-workspaces": {
            "*": 3
        }
    },
        "custom/arch": {
        "format": "",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },

    "clock": {
        "format": "{:%H:%M %d.%m.%y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },

    "tray": {
        "spacing": 10
    },

    "memory": {
        "format": "{}%  "
    },

    "cpu": {
        "format": "{usage}% 󰍛"
    },

    "network": {
        "format-wifi": " ",
        "format-ethernet": "󰈀 ",
        "format-disconnected": "󱚼",
        "tooltip-format": "{essid}\n{ipaddr}",
        "on-click": "kitty --class menu-network -e ~/.config/waybar/scripts/network.sh"
    },

    "bluetooth": {
        "format": "󰂯",
        "tooltip": false,
        "on-click": "kitty --class menu -e ~/.config/waybar/scripts/bluetooth.sh"
    },

    "pulseaudio": {
        "format": "{volume}% {icon} ",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
            "headphone": "",
            "hands-free": "󰂑",
            "headset": "󰂑",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "scroll-step": 1,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "kitty --class menu -e ~/.config/waybar/scripts/power.sh"
    }
}
